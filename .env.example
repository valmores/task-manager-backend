# ==========================================
# TaskMaster Backend - Environment Template
# ==========================================
# Instructions:
# 1. Copy this file and rename it to `.env`
# 2. Update the values below to match your environment

# Security
# WARNING: Keep your secret key secret in production!
SECRET_KEY=your-super-secret-django-key-here
# Set to 'False' in production
DEBUG=True

# Hosts
# Comma-separated list of allowed hosts (e.g., localhost,127.0.0.1,yourdomain.com)
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (Optional: Defaults to SQLite if not provided)
# DB_NAME=task_manager_db
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=127.0.0.1
# DB_PORT=5432
